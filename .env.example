# ============================================
# Hakuryu Dashboard — Variáveis de ambiente
# ============================================
# Copie este arquivo para .env e preencha com os valores do seu servidor.

# -------------------------------------------------
# Supabase (banco de dados da gang)
# -------------------------------------------------
# URL do projeto Supabase — encontrada em Project Settings > API > URL
HAKURYU_SUPABASE_URL=https://xxxx.supabase.co

# Service Role Key do Supabase — encontrada em Project Settings > API > service_role key
# NUNCA compartilhe ou exponha esta chave no frontend.
HAKURYU_SUPABASE_SERVICE_ROLE_KEY=eyJ...

# -------------------------------------------------
# Discord (aplicativo + bot)
# -------------------------------------------------
# Client ID do aplicativo OAuth — Discord Developer Portal > OAuth2 > Client ID
DISCORD_CLIENT_ID=1234567890123456789

# Client Secret do aplicativo OAuth — Discord Developer Portal > OAuth2 > Client Secret
DISCORD_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL fixa de callback OAuth. Use o domínio publicado do projeto:
# Exemplo: https://meu-projeto.lovable.app/api/public/auth/discord/callback
# Se deixar vazio, o callback monta a URL automaticamente a partir do domínio atual.
DISCORD_REDIRECT_URI=

# Token do bot do Discord — Discord Developer Portal > Bot > Token
# O bot precisa estar no servidor com permissões de gerenciar cargos, canais e membros.
DISCORD_BOT_TOKEN=MTAw...

# ID do servidor do Discord (fallback). Pode ser sobrescrito na aba Configurações do painel.
DISCORD_GUILD_ID=1234567890123456789

# ID do dono do painel (fallback). Pode ser sobrescrito na aba Configurações do painel.
DISCORD_OWNER_ID=1234567890123456789

# -------------------------------------------------
# Segurança
# -------------------------------------------------
# Chave secreta para assinar os cookies de sessão.
# Gere um valor aleatório forte, por exemplo com: openssl rand -hex 32
HAKURYU_SESSION_SECRET=substitua_por_um_segredo_longo_e_aleatorio
